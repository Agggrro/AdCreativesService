{
  "name": "creosmith",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "dev:https": "next dev --experimental-https -H 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "build:runtime": "node runtime/build.mjs",
    "runtime:push": "node --env-file=.env.local scripts/runtime-push.mjs",
    "db:schema": "node --env-file=.env.local scripts/db-apply.mjs supabase/schema.sql",
    "db:seed": "node --env-file=.env.local scripts/db-apply.mjs supabase/seed.sql",
    "deploy:status": "node --env-file=.env.local scripts/deploy-status.mjs",
    "check:vast": "node scripts/check-vast-fixtures.mjs",
    "check:entitlement": "node --env-file-if-exists=.env.local scripts/check-entitlement.mjs",
    "snapshot:backfill": "node --env-file=.env.local --import ./scripts/register-app-imports.mjs scripts/snapshot-backfill.mjs",
    "check:snapshots": "node --env-file-if-exists=.env.local --import ./scripts/register-app-imports.mjs scripts/check-snapshots.mjs",
    "test:entitlement": "node --test lib/serving/entitlement.test.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "^3.9.3",
    "@vercel/speed-insights": "^2.0.0",
    "fast-xml-parser": "^5.10.1",
    "fluid-player": "^3.59.0",
    "lucide-react": "^1.22.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "terser": "^5.49.2",
    "typescript": "^5"
  }
}
