# CreoSmith — environment variables
# Copy to .env.local and fill in. NEVER commit real values (.env* is gitignored).
# See docs/security.md for which are server-only.

# --- Supabase ---
# Public (safe in client bundle — RLS enforces access):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — full DB power, bypasses RLS. MUST NOT reach the client bundle.
# Every use is listed in docs/security.md, "Secrets" — the serving read, the
# beacon/click/postback writes, the Stripe webhook, snapshot publishing, its
# audit and reconciler, and the scripts. A new use is a change to that list.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only, and used ONLY by `npm run db:schema` / `npm run db:seed` — the app
# itself never opens a raw Postgres connection. Supabase dashboard ->
# Project Settings -> Database -> Connection string -> **Session pooler** (or
# Direct connection). NOT the transaction pooler on port 6543: it cannot run a
# multi-statement script. Replace [YOUR-PASSWORD] with the database password.
DATABASE_URL=

# --- Stripe ---
# Public (client checkout):
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Server-only:
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs (create the products/prices in the Stripe dashboard):
STRIPE_PRICE_SINGLE_WEEKLY=     # $2 / week, single template
STRIPE_PRICE_SINGLE_MONTHLY=    # $5 / month, single template
STRIPE_PRICE_ULTIMATE_MONTHLY=  # $30 / month, all-access

# --- App ---
# Public base URL (used for VAST tag URLs, Stripe redirects, signed-URL audience):
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Serving snapshots on Workers KV (ADR-0029) ---
# Where the serving snapshots live: the namespace `creosmith-snapshots`. The ad
# Worker reads it through its binding; everything else — the scripts, and the app
# while it still runs on Vercel — writes it over the REST API with this token.
# Set all three or none. Server-only: the token is a Cloudflare API token with
# Workers KV Storage: Edit and nothing else, and it can decide whether any tag
# serves (docs/security.md).
CLOUDFLARE_ACCOUNT_ID=
SNAPSHOT_KV_NAMESPACE_ID=
SNAPSHOT_KV_API_TOKEN=

# --- Deploying the Workers (ADR-0029) ---
# NOT an app variable — never set it on a deployment. The wrangler deploy token,
# for deploying by hand from this machine; CI holds the same token as a GitHub
# Actions secret. Note that `cf` and `wrangler` both pick it up from the
# environment, so a `cf` command that must run with your own login (creating
# tokens, zone settings) has to run from outside this folder.
CLOUDFLARE_API_TOKEN=

# --- Serving snapshots on Vercel Blob (ADR-0015 — the store being left) ---
# Server-only. Read/write token for the PRIVATE Vercel Blob store that held the
# serving snapshots before ADR-0029. The app's Worker no longer writes it; the Node
# scripts below still write both stores while Vercel is kept for a rollback, and
# this goes with the Blob store.
# On Vercel you do NOT need this: connecting the store to the project injects
# BLOB_STORE_ID + VERCEL_OIDC_TOKEN and the SDK prefers them. It is required only
# for code running outside Vercel — today that is `npm run snapshot:backfill` and
# `npm run media:migrate`.
# Vercel dashboard -> Storage -> your Blob store -> .env.local tab.
BLOB_READ_WRITE_TOKEN=

# --- Creative runtime on Vercel Blob (ADR-0017 — the store being left) ---
# The units now live on R2 under runtime/ and `npm run runtime:push` uses the R2
# variables below (ADR-0029). This token is read only by the one-off
# `npm run runtime:migrate`, which copied the public Blob store to R2.
RUNTIME_BLOB_READ_WRITE_TOKEN=

# --- Cron routes (GET /api/cron/health, /api/cron/reconcile) ---
# Server-only. The bearer both cron routes demand (`Authorization: Bearer <value>`,
# compared in constant time): the web Worker's scheduled handler sends it
# in-process, Vercel's cron did over the network. The routes refuse to run without
# it — they read across every tenant, write the snapshot stores and answer with
# creative and user ids. Generate with `openssl rand -base64 32`.
CRON_SECRET=

# --- Deploy status (scripts/deploy-status.mjs) ---
# Server-only, OPTIONAL — only needed to check a Vercel deployment's state from
# the command line instead of the dashboard. vercel.com/account/tokens.
VERCEL_TOKEN=
# Only needed if the project lives under a Vercel team, not a personal
# account — the script's own error message explains how to find it.
VERCEL_TEAM_ID=

# --- Live ad preview (dashboard configurator "Launch Ad") ---
# Server-only. Signs the short-TTL (120s), stateless preview tokens used by
# GET /api/vast/preview/[token]. Independent of the Supabase/Stripe secrets
# above — generate with e.g. `openssl rand -base64 32`.
PREVIEW_TOKEN_SECRET=

# --- Tracking beacon signing (/t, /r) ---
# Server-only. Signs the beacon URLs and click links the VAST builder embeds. If
# unset, a key is derived from PREVIEW_TOKEN_SECRET (see lib/track-token.ts); set in
# production since 2026-10-03. It and PREVIEW_TOKEN_SECRET must be EQUAL in the ad
# Worker and in the app — a link one signs, the other verifies (ADR-0029) — so
# change them in both at once.
TRACK_TOKEN_SECRET=

# --- Local development sign-in (GET /api/dev/session) ---
# LOCAL ONLY, OPTIONAL. Credentials of an ordinary account you created yourself
# (via /signup or the Supabase dashboard) on your development project. Visiting
# /api/dev/session signs that account in and redirects to the dashboard, so an
# automated browser can reach authenticated pages without a human typing into
# the login form.
# The route does not exist unless BOTH are set AND the process is a local dev
# run — it returns 404 under NODE_ENV=production and on any Vercel deployment.
# Never point these at a real user, and never set them in Vercel.
# What keeps it off the network is that `npm run dev` binds 127.0.0.1. If you
# ever run the dev server on 0.0.0.0 for cross-device testing, clear these
# first: the header check that backs up the binding is spoofable, so anyone who
# can reach the port could otherwise sign in as this account. See docs/security.md.
DEV_LOGIN_EMAIL=
DEV_LOGIN_PASSWORD=

# --- Ad-serving domain (ADR-0018) ---
# Public base URL for everything a third-party player fetches: the VAST tag, the
# beacons, and the creative assets. Separate from NEXT_PUBLIC_SITE_URL so the ad
# domain and the app domain can differ.
# Leave EMPTY to keep serving everything from the app domain — that is the safe
# default and the rollback: unsetting it moves every tag back in one redeploy.
NEXT_PUBLIC_CDN_URL=

# --- Creative media and runtime on Cloudflare R2 (ADR-0028, ADR-0029) ---
# The same bucket also holds the creative units under runtime/, which
# `npm run runtime:push` writes with these credentials.
# Where advertiser uploads go and are served from. Set ALL FIVE or none: with
# any one missing, uploads go to the Supabase `creative-media` bucket as before
# ADR-0028. To roll back, unset the R2 credentials but KEEP NEXT_PUBLIC_MEDIA_URL
# while any config still points at it — it is what makes those URLs ours.
# Public, and inlined at BUILD time — set it before the build that should use it.
# The media host, a custom domain on the R2 bucket (no trailing slash):
NEXT_PUBLIC_MEDIA_URL=
# The S3 credential of a token with Object Read & Write on this one bucket and
# nothing else. Only R2_SECRET_ACCESS_KEY is secret (server-only: it can overwrite
# or delete any advertiser's media); the access key id rides in every presigned
# upload URL. Cloudflare dashboard -> R2 -> API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=creative-media

# --- Validator player sandbox (ADR-0021) ---
# Origin the VAST validator runs a stranger's creative on. It executes third-party
# JavaScript in the hosting document's origin (VpaidMode.INSECURE, which is what every
# production player does), so that document must not be the app: no session, no
# storage, no API of ours.
#
# Leave empty and NEXT_PUBLIC_CDN_URL is used instead — the ad domain is already a
# separate registrable domain. With neither set, the validator still analyses but
# refuses to play, which is deliberate: it fails closed rather than falling back to
# the app's own origin. Locally it needs neither, because `next dev -H 127.0.0.1`
# makes localhost and 127.0.0.1 two reachable origins on one server.
NEXT_PUBLIC_SANDBOX_URL=

# --- Web analytics (ADR-0029) ---
# Public: the Cloudflare Web Analytics site token for creosmith.com. It rides in
# every page and can only report a page view to this one site. Leave EMPTY locally
# so development sessions stay out of production numbers.
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=
